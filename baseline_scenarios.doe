BEGIN DESIGN
  VERSION=1.0
  NAME=Baseline Liquidity Risk Scenarios
  TYPE=Full Factorial Design
  DESCRIPTION=Systematic exploration of baseline liquidity parameters to assess days to illiquidity and maximum drawdown
  AUTHOR=Arena Liquidity Risk Analysis
  DATE=2026-02-07
  REPLICATIONS=30
END DESIGN

BEGIN FACTORS
  COUNT=3
  
  FACTOR 1
    NAME=Initial_Liquidity_Ratio
    TYPE=Numeric
    SUBTYPE=Discrete
    UNITS=Ratio
    LEVELS=6
    VALUES=0.05,0.10,0.15,0.20,0.25,0.30
    DESCRIPTION=Initial liquidity buffer as ratio of total assets
  END FACTOR
  
  FACTOR 2
    NAME=Daily_Withdrawal_Rate
    TYPE=Numeric
    SUBTYPE=Discrete
    UNITS=Ratio
    LEVELS=5
    VALUES=0.01,0.03,0.05,0.07,0.10
    DESCRIPTION=Daily withdrawal rate as proportion of liquid assets
  END FACTOR
  
  FACTOR 3
    NAME=Market_Stress_Level
    TYPE=Categorical
    LEVELS=3
    VALUES=Low,Medium,High
    DESCRIPTION=Market stress scenario affecting asset liquidation
  END FACTOR
END FACTORS

BEGIN RESPONSES
  COUNT=2
  
  RESPONSE 1
    NAME=Days_To_Illiquidity
    TYPE=Numeric
    UNITS=Days
    GOAL=Maximize
    DESCRIPTION=Number of days until liquidity falls below critical threshold
  END RESPONSE
  
  RESPONSE 2
    NAME=Maximum_Drawdown
    TYPE=Numeric
    UNITS=Percentage
    GOAL=Minimize
    DESCRIPTION=Maximum percentage decline in liquidity buffer
  END RESPONSE
END RESPONSES

BEGIN RUN_MATRIX
  RUNS=90
  # Full factorial: 6 × 5 × 3 = 90 runs
  # Format: Run, Initial_Liquidity_Ratio, Daily_Withdrawal_Rate, Market_Stress_Level
  
  RUN 1,0.05,0.01,Low
  RUN 2,0.05,0.01,Medium
  RUN 3,0.05,0.01,High
  RUN 4,0.05,0.03,Low
  RUN 5,0.05,0.03,Medium
  RUN 6,0.05,0.03,High
  RUN 7,0.05,0.05,Low
  RUN 8,0.05,0.05,Medium
  RUN 9,0.05,0.05,High
  RUN 10,0.05,0.07,Low
  RUN 11,0.05,0.07,Medium
  RUN 12,0.05,0.07,High
  RUN 13,0.05,0.10,Low
  RUN 14,0.05,0.10,Medium
